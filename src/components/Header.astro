---
/**
 * Site header. On the landing page it floats transparently over the hero;
 * everywhere else it sits in the normal flow with a hairline border.
 */
import { SITE, CATEGORIES, CATEGORY_SLUGS } from '../config/site';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const links = [
  ...CATEGORY_SLUGS.map((slug) => ({ href: `/${slug}/`, label: CATEGORIES[slug].name })),
  { href: '/about/', label: 'About' },
  // Last link is drawn as an outlined button on wide screens (.nav-cta in global.css).
  { href: '/gallery/', label: 'Gallery', cta: true },
] as { href: string; label: string; cta?: boolean }[];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header
  data-site-header
  class={`site-header ${transparent
    ? 'absolute inset-x-0 top-0 z-20'
    : 'border-b border-line bg-ink'}`}
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-2 px-5 py-5">
    <a href="/" class="font-serif text-lg uppercase tracking-[0.12em] text-paper hover:text-accent-bright">
      {SITE.shortTitle}
    </a>
    <!-- Phone-only menu button (shown by global.css when JS is running;
         without JS the links simply stay visible as before). -->
    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Menu"
    >
      <svg class="nav-icon-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="nav-icon-close h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      <ul class="flex flex-wrap items-center gap-x-7 gap-y-1 text-[0.82rem] font-medium uppercase tracking-[0.22em]">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={`transition-colors hover:text-accent-bright ${
                  isActive(link.href) ? 'text-accent-bright' : 'text-paper/85'
                } ${link.cta ? 'nav-cta' : ''}`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Phone menu: the button shows/hides the links (styles in global.css).
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
