---
/**
 * Shared shell for every page: <head>, fonts, header, footer.
 * Pass `transparentHeader` on pages (the landing page) where the header
 * should float over a full-bleed hero instead of sitting in the flow.
 */
import '../styles/global.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  transparentHeader?: boolean;
  /** Preview image for link shares (WhatsApp, Facebook, …). Defaults to the landing hero photo. */
  image?: ImageMetadata;
  /** Open Graph type — 'article' for posts, 'website' for everything else. */
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE.description,
  transparentHeader = false,
  image,
  type = 'website',
} = Astro.props;
const pageTitle = title ? `${title} — ${SITE.shortTitle}` : SITE.title;

// Absolute URLs (built from `site` in astro.config.mjs) for canonical + share tags.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const shareSource = image ?? (await getEntry('settings', 'landing'))!.data.hero;
const shareImage = await getImage({ src: shareSource, width: 1200, format: 'jpg' });
const shareImageUrl = new URL(shareImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(shareImage.attributes.width)} />
    <meta property="og:image:height" content={String(shareImage.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Mark that JS is running so scroll-reveal styles apply (see global.css),
      // and forward Netlify Identity invite/recovery links to the CMS.
      document.documentElement.classList.add('js');
      if (/(invite_token|recovery_token|confirmation_token|email_change_token)/.test(window.location.hash)) {
        window.location.replace('/admin/' + window.location.hash);
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal.js';
    </script>
  </body>
</html>
